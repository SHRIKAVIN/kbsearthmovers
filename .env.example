# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Authentication
VITE_ADMIN_PASSWORD=your_secure_admin_password

# Keep-alive / Vercel Cron (set these in Vercel project env)
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# TEAMS_WEBHOOK_URL=your_teams_incoming_webhook_url

# ---------------------------------------------------------------------------
# Cashfree Payments (server-side only - set these in the Vercel dashboard)
#
# Do NOT prefix any of these with VITE_. Vite inlines VITE_* variables into the
# browser bundle, which would publish your Cashfree secret to every visitor.
# ---------------------------------------------------------------------------
# CASHFREE_CLIENT_ID=your_cashfree_app_id
# CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
# CASHFREE_ENV=sandbox                      # sandbox | production
# CASHFREE_WEBHOOK_SECRET=                  # defaults to CASHFREE_CLIENT_SECRET
# CASHFREE_API_VERSION=2026-01-01

# Public origin, used to build Cashfree return_url / notify_url
# PUBLIC_BASE_URL=https://kbsearthmovers.vercel.app

# Shared secret for manually triggering /api/cron/payment-reminders
# CRON_SECRET=a_long_random_string
